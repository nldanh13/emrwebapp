# /etc/emrwebapp/emrwebapp.env — biến môi trường của dịch vụ emrwebapp trên VPS.
# install.sh tạo file này (quyền 600). Không đưa file này lên GitHub.

# Máy chủ Node chỉ nghe trong máy; Caddy (HTTPS) đứng trước, nhận kết nối từ Internet.
HOST=127.0.0.1
PORT=3001
NODE_ENV=production

# BẮT BUỘC: khai rõ file tài khoản để luôn bắt đăng nhập. Không có dòng này thì máy chủ thấy
# HOST=127.0.0.1 sẽ tưởng "chỉ một máy dùng" và BỎ QUA đăng nhập — ai mở link cũng vào được.
EMR_USERS_FILE=/opt/emrwebapp/secrets/users.json

# Chỉ thiết bị tin cậy (đã đăng ký + được duyệt) mới nhận dữ liệu; máy lạ đăng nhập đúng cũng
# chỉ thấy trang "Đăng ký thiết bị này". Xem docs/TRIEN_KHAI_VPS.md mục "Thiết bị tin cậy".
EMR_REQUIRE_TRUSTED_DEVICE=1

# EMR chỉ mở được trong mạng bệnh viện: VPS không vào EMR trực tiếp mà lấy trang EMR qua một tab
# trình duyệt trên máy bệnh viện (nút "Data Hub" trên thanh dấu trang). Xem docs/TRIEN_KHAI_VPS.md
# mục "Cầu nối tab EMR". Bỏ dòng này nếu VPS vào được EMR trực tiếp.
EMR_BRIDGE_MODE=1

# Python trong môi trường ảo do install.sh tạo.
PYTHON_BIN=/opt/emrwebapp/.venv/bin/python

# Giờ Việt Nam cho báo cáo, ngày giờ y lệnh.
TZ=Asia/Ho_Chi_Minh
