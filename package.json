{
  "name": "emr-dashboard",
  "version": "2.3.0",
  "private": true,
  "description": "Web app điều phối dữ liệu giường bệnh, y lệnh và tự động nhập EMR",
  "main": "server.js",
  "scripts": {
    "start": "node scripts/start.js",
    "dev:server": "node --watch server.js",
    "dev:ui": "vite",
    "dev": "concurrently -n SERVER,UI -c blue,green \"npm run dev:server\" \"npm run dev:ui\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "python -m pytest tests/ -v -s --tb=short",
    "test:syntax": "python -m compileall worker",
    "package:clean": "node scripts/prepare_release.js",
    "check": "node scripts/health_check.js",
    "debug:bundle": "node scripts/create_debug_bundle.js",
    "clean:project": "node scripts/clean_project.js",
    "check:syntax": "node scripts/check.mjs",
    "serve": "node server.js",
    "clean:hchanh": "node scripts/clean_hchanh_unused.js",
    "clean:hchanh:apply": "node scripts/clean_hchanh_unused.js --apply",
    "clean:hchanh:full": "node scripts/clean_hchanh_unused.js --hchanh-data --unused-code --apply",
    "runtime:v2": "node scripts/runtime_maint.js generate",
    "migrate:runtime": "node scripts/runtime_maint.js migrate-keys",
    "check:data": "node scripts/runtime_maint.js health",
    "package:data-shape": "node scripts/data_shape/export_data_shape.js",
    "check:data-shape": "node scripts/data_shape/export_data_shape.js --dry-run",
    "clean:unused": "node scripts/clean_unused.js",
    "clean:unused:apply": "node scripts/clean_unused.js --apply",
    "clean:unused:private": "node scripts/clean_unused.js --private-data --apply",
    "clean:unused:code": "node scripts/clean_unused.js --unused-code",
    "db:migrate": "node scripts/db_migrate.js",
    "test:ci": "python -m pytest tests/ -q && python -m compileall -q worker && node scripts/check.mjs && node scripts/workflow_smoke_test.js && node scripts/records_check_paper_status_test.js && node scripts/task_queue_account_lane_test.js && node scripts/records_check_shared_data_reuse_test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.1.0",
    "vite": "^8.0.13"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "notes": {
    "python_deps": "pip install -r requirements.txt",
    "dev_workflow": "npm run dev  →  UI: http://localhost:5173  |  API: http://localhost:3001",
    "prod_workflow": "npm install → npm start → tự build UI nếu cần → http://localhost:3001"
  }
}
